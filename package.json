{
    "name": "cnchar-monorepo",
    "version": "3.2.6",
    "private": true,
    "description": "功能全面、多端支持的汉字拼音笔画 js 库，支持多音字、繁体字、火星文（pnpm monorepo）",
    "author": "theajack <theajack@qq.com>",
    "license": "MIT",
    "keywords": [
        "cnchar",
        "chinese-character",
        "chinese-pinyin",
        "chinese-character-strokes",
        "传统字",
        "汉字拼音",
        "汉字笔画",
        "汉字笔顺",
        "繁体字",
        "汉字工具"
    ],
    "packageManager": "pnpm@9.12.3",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "dev": "pnpm --filter @cnchar/playground dev",
        "dev:test": "pnpm --filter @cnchar/playground exec vite --open /dev-test.html",
        "build": "node ./scripts/gen-version.mjs && pnpm -r --filter \"./packages/**\" run build && node ./scripts/post-build.mjs",
        "build:main": "pnpm --filter cnchar build",
        "build:types": "pnpm --filter cnchar-types build",
        "build:docs": "vuepress build vuepress && node ./scripts/build-docs.mjs",
        "dev:docs": "vuepress dev vuepress",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:dist": "node ./test/index.js",
        "lint": "eslint packages --ext .ts",
        "lint:fix": "eslint --fix packages --ext .ts",
        "purge": "node ./scripts/purge-cdn.mjs",
        "clean": "node ./scripts/clean.mjs",
        "publish:packages": "node ./scripts/publish.mjs"
    },
    "devDependencies": {
        "@commitlint/cli": "^8.3.5",
        "@commitlint/config-conventional": "^8.3.4",
        "@types/node": "^22.9.0",
        "@vuepress/plugin-back-to-top": "^1.9.10",
        "@vuepress/plugin-medium-zoom": "^1.9.10",
        "chalk": "^4.1.2",
        "core-js": "^2.6.12",
        "easy-icon": "^1.0.2",
        "element-ui": "^2.15.14",
        "eslint": "^6.8.0",
        "highlight.js": "^9.18.5",
        "husky": "^3.1.0",
        "jsdom": "^25.0.1",
        "less": "^3.13.1",
        "less-loader": "^5.0.0",
        "typescript": "^5.6.3",
        "vite": "^5.4.10",
        "vitest": "^2.1.4",
        "vue": "^2.7.16",
        "vue-highlight.js": "^2.2.0",
        "vuepress": "^1.9.10",
        "vuepress-plugin-tc-comment": "^0.0.11"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
